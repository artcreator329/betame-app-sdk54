{
  "expo": {
    "name": "BetaMe",
    "slug": "betame",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "betame",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/icon_splashscreen.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f1419"
    },
    "backgroundColor": "#0f1419",
    "newArchEnabled": false,
    "linking": {
      "prefixes": [
        "betame://",
        "https://betame.com.my"
      ],
      "config": {
        "screens": {
          "profile/[userId]": "profile/:userId",
          "auth/reset-password": "auth/reset-password",
          "auth/verify-email": "auth/verify-email",
          "payment/success": "payment/success",
          "payment/cancel": "payment/cancel",
          "payment/failed": "payment/failed"
        }
      }
    },
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "<REDACTED_GOOGLE_API_KEY>"
      },
      "bundleIdentifier": "com.betame.app",
        "buildNumber": "12",
      "backgroundColor": "#0f1419",
      "appleTeamId": "T72JDH8ZL6"
    },
    "android": {
      "config": {
        "googleMaps": {
          "apiKey": "<REDACTED_GOOGLE_API_KEY>"
        }
      },
      "package": "com.betame.app",
      "versionCode": 18,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0f1419"
      },
      "backgroundColor": "#0f1419"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "config": {
        "googleMapsApiKey": "${EXPO_PUBLIC_GOOGLE_PLACES_API_KEY}"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-dev-client",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#007AFF",
          "sounds": [
            "./assets/sfx.wav"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "205a3431-8510-43a6-8801-b21297ac679e"
      }
    },
    "owner": "betame-sdn-bhd"
  }
}
