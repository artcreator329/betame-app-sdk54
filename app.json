{
  "expo": {
    "name": "BetaMe",
    "slug": "betame",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "betame",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/icon_splashscreen.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f1419"
    },
    "backgroundColor": "#0f1419",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "$EXPO_PUBLIC_GOOGLE_MAPS_API_KEY"
      },
      "bundleIdentifier": "com.betame.app",
      "buildNumber": "20",
      "backgroundColor": "#0f1419",
      "appleTeamId": "T72JDH8ZL6",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs access to location to help you find nearby services and provide location-based features.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app needs access to location to help you find nearby services and provide location-based features.",
        "NSLocationAlwaysUsageDescription": "This app needs access to location to help you find nearby services and provide location-based features."
      }
    },
    "android": {
      "config": {
        "googleMaps": {
          "apiKey": "$EXPO_PUBLIC_GOOGLE_MAPS_API_KEY"
        }
      },
      "package": "com.betame.app",
      "versionCode": 20,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0f1419"
      },
      "backgroundColor": "#0f1419"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "config": {
        "googleMapsApiKey": "${EXPO_PUBLIC_GOOGLE_PLACES_API_KEY}"
      },
      "build": {
        "babel": {
          "include": []
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-dev-client",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#007AFF",
          "sounds": [
            "./assets/sfx.wav"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false,
        "unstable_src": "./app"
      },
      "eas": {
        "projectId": "205a3431-8510-43a6-8801-b21297ac679e"
      }
    },
    "owner": "betame-sdn-bhd"
  }
}